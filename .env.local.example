# Supabase 프로젝트 주소. Supabase 화면: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase 공개 키. Project Settings -> API Keys -> "anon public" (또는 Publishable key)
# service_role / secret 키가 아닙니다. 브라우저에 노출되어도 되는 키만 넣습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- 문자 발송 (서버 전용, NEXT_PUBLIC_ 붙이지 않는다) ----
# 솔라피 콘솔 → API Key 관리에서 발급. 비어 있으면 앱은 "문자 설정이 아직 안 되어 있습니다"라고만 안내한다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록한 병원 발신번호. 숫자만 (예: 0212345678)
SMS_SENDER_NUMBER=
