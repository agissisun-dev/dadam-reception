# Supabase 프로젝트 주소. Supabase 화면: Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase 공개 키. Project Settings -> API Keys -> "anon public" (또는 Publishable key)
# service_role / secret 키가 아닙니다. 브라우저에 노출되어도 되는 키만 넣습니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
